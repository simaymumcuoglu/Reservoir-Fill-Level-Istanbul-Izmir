# Copy to .env and fill in your values. Never commit .env to Git.

# Option 1: Separate variables (put password in quotes if it contains special chars)
DB_HOST=localhost
DB_PORT=5431
DB_NAME=dam_datas
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Option 2: Single URL (use %40 instead of @ in password if needed)
# DATABASE_URL=postgresql://user:password@localhost:5431/dam_datas
